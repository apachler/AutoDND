#!/usr/bin/env python3
from datetime import datetime,timedelta
from typing import List,Tuple,Optional
from subprocess import run
from time import sleep
from os import environ,makedirs
from os.path import join
from argparse import ArgumentParser,Namespace
from sys import stderr,exit as sys_exit
import logging

log=logging.getLogger('autodnd')
_last_state:Optional[bool]=None

def next_weekday(weekday:int,start:datetime,end:datetime)->List[Tuple[datetime,datetime]]:
    current:datetime=get_now()
    delta:int = weekday-current.weekday()
    if delta<0 or (delta==0 and end<=current):
        delta+=7
    occurrences:List[Tuple[datetime,datetime]]=[(start+timedelta(days=delta),end+timedelta(days=delta))]
    prev_end:datetime=end+timedelta(days=delta-7)
    if prev_end>current:
        occurrences.insert(0,(start+timedelta(days=delta-7),prev_end))
    return occurrences

def create_datetime(time:str)->datetime:
    current:datetime=get_now()
    parts: List[str] = time.split(':')
    if len(parts)!=2:
        raise ValueError(f"invalid time {time!r}, expected HH:MM")
    try:
        hour:int=int(parts[0])
        minute:int=int(parts[1])
    except ValueError as e:
        raise ValueError(f"invalid time {time!r}") from e
    if not (0<=hour<=23 and 0<=minute<=59):
        raise ValueError(f"time {time!r} out of range")
    return current.replace(hour=hour,minute=minute)

def read_days(event:str)->List[Tuple[datetime,datetime]]:
    parts:List[str]=event.split()
    if len(parts)!=3:
        raise ValueError(f"expected '<days> <start> <end>', got {event!r}")
    try:
        days:List[int]=[int(a) for a in parts[0].split(',')]
    except ValueError as e:
        raise ValueError(f"invalid day list {parts[0]!r}") from e
    for d in days:
        if not 0<=d<=6:
            raise ValueError(f"day {d} out of range (0=Mon … 6=Sun)")
    result:List[Tuple[datetime,datetime]]=[]
    start:datetime=create_datetime(parts[1])
    end:datetime=create_datetime(parts[2])
    if end<start:
        end:datetime=end+timedelta(days=1)
    for day in days:
        result.extend(next_weekday(day,start,end))
    return result

def set_dnd(enabled:bool)->None:
    run(['gsettings','set','org.gnome.desktop.notifications','show-banners',str(not enabled).lower()],check=True)

def parse_lines(lines:List[str])->List[Tuple[datetime,datetime]]:
    events:List[Tuple[datetime,datetime]]=[]
    for lineno,line in enumerate(lines,1):
        if '#' in line:
            line = line[:line.find('#')]
        line = line.strip()
        if len(line) == 0:
            continue
        try:
            events.extend(read_days(line))
        except ValueError as e:
            raise ValueError(f"line {lineno}: {e}") from e
    return events

def get_now()->datetime:
    return datetime.now().replace(second=0,microsecond=0)

def main()->None:
    parser:ArgumentParser=ArgumentParser()
    parser.add_argument('-d','--debug',action='store_true',default=False)
    args:Namespace=parser.parse_args()
    logging.basicConfig(
        level=logging.DEBUG if args.debug else logging.INFO,
        format='%(asctime)s %(levelname)s %(message)s',
    )

    folder:str=join(environ['HOME'],'.config','autodnd')
    makedirs(folder,exist_ok=True)
    file:str=join(folder,'config.txt')
    open(file,'a').close()
    with open(file) as f:
        lines: List[str] = f.readlines()

    try:
        parse_lines(lines)
    except ValueError as e:
        print(f"autodnd: config error: {e}",file=stderr)
        sys_exit(2)

    while True:
        events: List[Tuple[datetime, datetime]] = parse_lines(lines)
        for start,end in events:
            log.debug('event %s -> %s',start,end)
        delta:timedelta=execute(events)
        sleep_time:int=delta.seconds+60*60*24*delta.days
        log.debug('sleeping %s (%ds)',delta,sleep_time)
        sleep(sleep_time)

def desired_state(events:List[Tuple[datetime,datetime]],current:datetime)->bool:
    return any(start<=current<end for start,end in events)

def next_transition(events:List[Tuple[datetime,datetime]],current:datetime)->Optional[datetime]:
    boundaries:List[datetime]=[]
    for start,end in events:
        if start>current: boundaries.append(start)
        if end>current: boundaries.append(end)
    return min(boundaries) if boundaries else None

def execute(events:List[Tuple[datetime,datetime]])->timedelta:
    global _last_state
    if len(events)==0:
        sys_exit(0)
    current:datetime = get_now()
    state:bool = desired_state(events,current)
    if state != _last_state:
        log.info('DnD %s',('on' if state else 'off'))
        set_dnd(state)
        _last_state = state
    transition:Optional[datetime] = next_transition(events,current)
    if transition is None:
        return timedelta(hours=1)
    return (transition-datetime.now())+timedelta(seconds=5)

if __name__=='__main__':
    main()
